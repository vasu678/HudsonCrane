# Copy to .env and fill in your values. NEVER commit .env.

# Google Slides / Drive (OAuth Desktop app)
OAUTH_CLIENT_SECRETS_FILE=client_secrets.json

# Google Slides template
TEMPLATE_PRESENTATION_ID=
TEMPLATE_SLIDE_ID=
TWO_PRODUCT_TEMPLATE_SLIDE_ID=

# Google Cloud Storage
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=gcs_key.json

# Background removal model (u2net is default; birefnet-general is higher quality but slower)
REMBG_MODEL=u2net
